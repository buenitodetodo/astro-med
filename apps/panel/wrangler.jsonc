{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astro-med-panel",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/*", "/auth/*"]
  },
  "services": [{ "binding": "API", "service": "astro-med-api" }]
}
