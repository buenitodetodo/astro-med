---
import Shell from '../layouts/Shell.astro';
---

<Shell title="Not found">
  <main class="min-h-screen flex items-center justify-center p-8">
    <div class="bg-white rounded-card border border-slate-200/70 p-8 shadow-sm text-center space-y-2">
      <div class="text-[11px] font-label-caps font-bold tracking-widest text-slate-400">ERROR 404</div>
      <h1 class="text-2xl font-display-lg font-bold text-slate-800">Page not found</h1>
      <a href="/" class="text-sm font-semibold text-primary">Back to the summary</a>
    </div>
  </main>
</Shell>
